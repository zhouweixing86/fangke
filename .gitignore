# Office 临时文件
~$*
*.tmp

# 系统文件
Thumbs.db
desktop.ini
.DS_Store

# 编辑器
.vscode/
.idea/

# Python 缓存
__pycache__/
*.pyc
# Java / Maven
server/target/
*.class
*.log

# 前端
web/node_modules/
web/dist/
web/.vite/
web/*.tsbuildinfo
uniapp/node_modules/
uniapp/dist/
uniapp/.vite/
uniapp/*.tsbuildinfo

# 工具/调试产物
.playwright-mcp/
.tmp-shots/

# 自动驾驶台运行时（报告、状态、日志、提示词）
.autopilot/

# 私有凭据/服务器连接信息（含明文口令，永不入库）
private/

# 本机开发配置（含真实口令），入库的是 application-dev.yml.example
server/src/main/resources/application-dev.yml
