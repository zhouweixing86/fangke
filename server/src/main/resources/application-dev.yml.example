# 开发环境配置模板（明文，可入库）
#
# 用法：复制成同目录下的 application-dev.yml，把口令改成自己的即可。
#   copy application-dev.yml.example application-dev.yml
# application-dev.yml 已被 .gitignore 忽略，不会把真实口令提交上去。

spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/fangke?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
    username: root
    password: CHANGE_ME

server:
  port: 8080
  tomcat:
    accesslog:
      enabled: true
      buffered: false
      directory: D:/fangke/server/logs
      prefix: access
      suffix: .log
      file-date-format: ""
      pattern: "%t %a %m %U %s %b"

logging:
  level:
    com.fangke: DEBUG

fangke:
  device:
    pull-verify-sign: false
    pull-sign-key: fangke-pull-key
    pull-heart-seconds: 30
    pull-public-base-url: http://<本机局域网IP>:8080

  storage:
    endpoint: http://127.0.0.1:9000
    bucket: fangke
    access-key: CHANGE_ME
    secret-key: CHANGE_ME

  jwt:
    secret: dev-only-change-me
  qr:
    secret: dev-only-qr-secret
