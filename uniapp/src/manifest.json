{
  "name": "访客通行",
  "appid": "",
  "description": "访客系统移动端（访客/员工/管理端），一套代码出 H5、微信小程序、APP",
  "versionName": "1.0.0",
  "versionCode": "100",
  "transformPx": false,
  "app-plus": {
    "usingComponents": true,
    "nvueStyleCompiler": "uni-app",
    "compilerVersion": 3,
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {
      "Barcode": {},
      "Camera": {}
    },
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.CAMERA\"/>",
          "<uses-permission android:name=\"android.permission.INTERNET\"/>",
          "<uses-permission android:name=\"android.permission.ACCESS_NETWORK_STATE\"/>"
        ],
        "minSdkVersion": 21,
        "targetSdkVersion": 33,
        "abiFilters": ["armeabi-v7a", "arm64-v8a"]
      },
      "ios": {},
      "sdkConfigs": {}
    }
  },
  "quickapp": {},
  "mp-weixin": {
    "appid": "",
    "setting": {
      "urlCheck": false,
      "es6": true,
      "minified": true
    },
    "usingComponents": true,
    "permission": {
      "scope.camera": {
        "desc": "扫描访客通行码需要摄像头"
      }
    }
  },
  "h5": {
    "title": "访客通行",
    "router": {
      "mode": "hash",
      "base": "/"
    },
    "devServer": {
      "port": 5175,
      "proxy": {
        "/api": {
          "target": "http://127.0.0.1:8080",
          "changeOrigin": true,
          "secure": false
        }
      }
    },
    "optimization": {
      "treeShaking": {
        "enable": true
      }
    }
  },
  "vueVersion": "3"
}
